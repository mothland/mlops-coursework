{
  "seed": 42,
  "valid_size": 0.2,
  "test_size": 0.2,
  "threshold": 0.5,
  "selection": {
    "metric": "average_precision",
    "tie_tolerance": 0.01,
    "simplicity_order": ["logistic_regression", "decision_tree", "random_forest"],
    "rule": "Highest validation average precision among learned candidates; any candidate within tie_tolerance of the best is a tie, and ties go to the earliest (simplest) in simplicity_order."
  },
  "baseline": {"kind": "dummy", "params": {"strategy": "most_frequent"}},
  "candidates": {
    "logistic_regression": {
      "kind": "logistic_regression",
      "params": {"max_iter": 1000}
    },
    "decision_tree": {
      "kind": "decision_tree",
      "params": {"max_depth": 5, "min_samples_leaf": 20, "random_state": 42}
    },
    "random_forest": {
      "kind": "random_forest",
      "params": {"n_estimators": 300, "max_depth": 8, "min_samples_leaf": 10, "random_state": 42, "n_jobs": -1}
    }
  },
  "output_dir": "artifacts/tp02"
}
